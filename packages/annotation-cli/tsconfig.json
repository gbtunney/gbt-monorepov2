{
    "extends": "@snailicid3/config/tsconfig.typecheck",
    "compilerOptions": {
        "lib": ["ES2022"],
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "exclude": ["./node_modules"],
    "files": ["package.json"],
    "include": [
        "./*.ts",
        "./*.cts",
        "./*.mts",
        "./src/**/*.ts",
        "./src/**/*.cts",
        "./src/**/*.mts",
        "./**/*.test.ts",
        "./**/*.test.mts",
        "./**/*.test.cts"
    ]
}
