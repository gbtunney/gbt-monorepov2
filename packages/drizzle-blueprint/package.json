{
    "name": "@gbt/drizzle-blueprint",
    "version": "0.0.0",
    "private": true,
    "description": "Drizzle ORM blueprint for Zod Express API",
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev"
    },
    "nx": {
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "dev:vite": {},
            "check:ts": {},
            "build:tsdown": {},
            "build:ts": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "dependencies": {
        "better-sqlite3": "^13.0.2",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "express": "^5.2.1",
        "express-zod-api": "^29.6.1",
        "http-errors": "^2.0.1",
        "zod": "^4.6.1"
    },
    "devDependencies": {
        "@snailicid3/build-config": "^0.2.0",
        "@snailicid3/config": "^0.3.2",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/node": "^26.5.0",
        "cross-var": "^1.1.0",
        "drizzle-kit": "^0.31.10",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0"
    },
    "type": "module",
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/gbt-template-boilerplate",
        "directory": "packages/drizzle-blueprint"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "keywords": [
        "boilerplate"
    ],
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    }
}
